    fontSize: 16,
  },
  transactionInfo: {
    flex: 1,
  },
  merchant: {
    fontSize: 15,
    fontWeight: '600',
    color: '#172033',
  },
  category: {
    fontSize: 12,
    color: '#7B8493',
