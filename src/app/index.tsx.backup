  },
  amount: {
    fontSize: 12,
    fontWeight: '700',
    marginLeft: 8,
    textAlign: 'right',
  },
  amountNegative: {
    color: '#D44D45',
  },
  message: {
    alignItems: 'center',
    padding: 24,
    backgroundColor: '#FFFFFF',
    borderRadius: 14,
    gap: 12,
  },
  messageText: {
    color: '#667085',
  },
  error: {
    color: '#B42318',
    marginVertical: 12,
  },
  empty: {
    textAlign: 'center',
    color: '#737D8C',
    marginTop: 24,
  },
  retryButton: {
    backgroundColor: '#294B7A',
