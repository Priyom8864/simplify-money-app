  },
  balance: {
    fontSize: 30,
    fontWeight: '700',
    color: '#FFFFFF',
    marginTop: 8,
    marginBottom: 24,
  },
  summaryRow: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    borderTopWidth: 1,
    borderTopColor: '#405476',
    paddingTop: 18,
  },
  income: {
    color: '#16865C',
    fontWeight: '600',
    marginTop: 6,
  },
  expense: {
    color: '#FFD2CB',
    fontWeight: '600',
    marginTop: 6,
  },
  transactionCount: {
    color: '#C5D0E2',
    fontSize: 12,
    marginTop: 18,
  },
  sectionTitle: {
    fontSize: 20,
    fontWeight: '700',
    color: '#172033',
    marginTop: 28,
    marginBottom: 14,
  },
  search: {
    backgroundColor: '#FFFFFF',
    borderWidth: 1,
    borderColor: '#E1E6ED',
    borderRadius: 12,
    paddingHorizontal: 15,
    paddingVertical: 13,
    fontSize: 15,
    marginBottom: 12,
  },
  transaction: {
    flexDirection: 'row',
    alignItems: 'center',
    backgroundColor: '#FFFFFF',
    borderRadius: 14,
    padding: 14,
    marginBottom: 10,
  },
  transactionIcon: {
    width: 42,
    height: 42,
    borderRadius: 21,
    backgroundColor: '#EAF0FA',
    justifyContent: 'center',
    alignItems: 'center',
    marginRight: 12,
  },
  iconText: {
    fontWeight: '700',
